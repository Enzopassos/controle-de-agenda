{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agenda-AutoEscola-SaoJoao",
  "version": "1.0.0",
  "identifier": "br.com.autoescolasaojoao.agenda",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/widget",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Escola São João - Agenda",
        "width": 420,
        "height": 650,
        "minWidth": 360,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
